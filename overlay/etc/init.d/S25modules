#!/bin/sh
#
# Load the modules this board always needs.
#
# mdev's coldplug pass should load these from $MODALIAS anyway, but the two
# that matter -- the display and the only network interface -- are not worth
# leaving to chance. modprobe of an already-loaded module is a no-op, so this
# is pure insurance.

case "$1" in
	start)
		# HDMI audio (ASoC) must exist before vc4 probes, or KMS sits
		# in deferred probe and /dev/dri never appears (beta.3).
		modprobe cec 2>/dev/null
		modprobe i2c-bcm2835 2>/dev/null
		modprobe drm_display_helper 2>/dev/null
		modprobe drm_dma_helper 2>/dev/null
		modprobe snd-soc-core 2>/dev/null
		modprobe snd-pcm-dmaengine 2>/dev/null
		modprobe snd-soc-hdmi-codec 2>/dev/null
		modprobe vc4 2>/dev/null

		# Wi-Fi. The Zero 2 W has no Ethernet.
		modprobe brcmfmac 2>/dev/null
		;;
	stop|restart|reload)
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
esac

exit 0
