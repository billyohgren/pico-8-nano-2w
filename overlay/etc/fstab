# The OS is the initramfs (already mounted as /). Both card partitions are
# FAT32 so they mount on a Mac. Nothing on the card is the rootfs.
#
# /boot is mounted exec because the user-supplied PICO-8 binary lives there
# and is executed in place. umask=0022 gives it the executable bit -- FAT has
# no permission bits of its own.
#
# /data uses umask=077 so sshd will accept host keys it generates there
# (OpenSSH refuses world-readable keys). flush asks the driver to write
# the FAT more often; it is not a journal. A power cut can still lose
# saves. It cannot brick the firmware, which lives on p1 and is mounted ro.

/dev/mmcblk0p1  /boot           vfat    ro,exec,umask=0022,noatime  0 0
/dev/mmcblk0p2  /data           vfat    rw,noatime,flush,utf8,shortname=mixed,umask=077  0 0

proc            /proc           proc    defaults                0 0
devpts          /dev/pts        devpts  defaults,gid=5,mode=620 0 0
tmpfs           /dev/shm        tmpfs   mode=0777               0 0
tmpfs           /tmp            tmpfs   mode=1777               0 0
tmpfs           /run            tmpfs   mode=0755,nosuid,nodev  0 0
sysfs           /sys            sysfs   defaults                0 0
