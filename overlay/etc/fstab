# The OS is the initramfs (already mounted as /). The card is one FAT32
# volume: firmware, the pico-8 binary, carts, saves. Mounted rw so PICO-8
# can save. umask=077 makes files 0700 — executable for root (pico8_dyn)
# and strict enough for sshd host keys. flush asks the driver to write
# the FAT more often; it is not a journal.

/dev/mmcblk0p1  /boot           vfat    rw,exec,noatime,flush,utf8,shortname=mixed,umask=077  0 0

proc            /proc           proc    defaults                0 0
devpts          /dev/pts        devpts  defaults,gid=5,mode=620 0 0
tmpfs           /dev/shm        tmpfs   mode=0777               0 0
tmpfs           /tmp            tmpfs   mode=1777               0 0
tmpfs           /run            tmpfs   mode=0755,nosuid,nodev  0 0
sysfs           /sys            sysfs   defaults                0 0
