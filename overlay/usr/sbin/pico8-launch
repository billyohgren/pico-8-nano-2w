#!/bin/sh
#
# Find the user-supplied PICO-8 on the boot partition and run it.
#
# PICO-8 is not part of this image -- it is proprietary and cannot be
# redistributed. The user drags their own pico-8 folder onto PICO8BOOT.
# Carts, saves and the binary all live on that one FAT volume.
#
# Any version works: we look for the known binary names rather than a
# pinned version, so dropping in a newer pico-8 folder just works.

set -u

BOOT=/boot
PICO_HOME="${BOOT}/pico-8"
LOGFILE="${BOOT}/pico8-launch.log"

# Serial and PICO8BOOT (pico8-launch.log). sync after every line so a
# crash still leaves the last crumb on FAT. The tester pulls the card
# and opens that file on a Mac — no serial adapter required.
log() {
	line="pico8-launch: $*"
	echo "$line" >&2
	if [ -d "${BOOT}" ]; then
		echo "$line" >> "${LOGFILE}" 2>/dev/null
		sync
	fi
}

dump_state() {
	log "uptime=$(cut -d' ' -f1 /proc/uptime 2>/dev/null) cmdline=$(cat /proc/cmdline 2>/dev/null)"
	log "mem: $(awk '/MemAvailable|MemFree|CmaTotal|CmaFree/ {printf "%s=%s ", $1, $2}' /proc/meminfo 2>/dev/null)"
	log "dri=$(ls /dev/dri 2>/dev/null | tr '\n' ' ')"
	log "connectors: $(for c in /sys/class/drm/card*-*/status; do [ -e "$c" ] && printf '%s=%s ' "$(basename "$(dirname "$c")")" "$(cat "$c")"; done)"
	log "sound: $(cat /proc/asound/cards 2>/dev/null | sed -n 's/^ *\([0-9]\) \[\([^ ]*\).*/\1:\2/p' | tr '\n' ' ')"
	if [ -d "${BOOT}" ]; then
		echo "----- dmesg -----" >> "${LOGFILE}" 2>/dev/null
		dmesg >> "${LOGFILE}" 2>/dev/null
		sync
	fi
}

# Text on the screen (tty1, fbcon on vc4) so a blank screen never means
# "did it even boot?". Lines stay under 40 columns: the GPi panel is 320
# pixels wide, 8 px per character. vc4 tells fbcon the panel's rotation,
# so this is upright there too. Unreadable before vc4 is up, harmless after.
say() {
	{
		printf '\033[2J\033[H\n'
		for l in "$@"; do printf ' %s\n' "$l"; done
	} > /dev/tty1 2>/dev/null
}

# Rotate before a respawn loop fills the 128 MB volume.
if [ -f "${LOGFILE}" ]; then
	sz=$(wc -c < "${LOGFILE}" 2>/dev/null | tr -d ' ')
	if [ -n "$sz" ] && [ "$sz" -gt 200000 ]; then
		mv -f "${LOGFILE}" "${LOGFILE}.old" 2>/dev/null
	fi
fi

log "---- boot ----"
dump_state

# Wait for KMS. usleep is 0.1 s; plain sleep 1 is the fallback if the
# applet is missing. Do not start PICO-8 without a DRM node: Mesa then
# aborts and BusyBox respawn turns that into a crash loop.
n=0
while [ ! -e /dev/dri/card0 ] && [ "$n" -lt 50 ]; do
	usleep 100000 2>/dev/null || sleep 1
	n=$((n + 1))
done
if [ ! -e /dev/dri/card0 ]; then
	log "no /dev/dri/card0 (vc4 did not come up). not starting PICO-8."
	dump_state
	sleep 10
	exit 1
fi

say "PICO-8 nano 2W" "" "Starting..."

# The folder may be called pico-8 (as shipped in Lexaloffle's zip) or pico8.
PICO_DIR=""
for d in "${BOOT}/pico-8" "${BOOT}/pico8"; do
	[ -d "$d" ] && { PICO_DIR="$d"; break; }
done

if [ -z "${PICO_DIR}" ]; then
	log "no PICO-8 found on the boot partition."
	log "Plug the card into a computer, open the PICO8BOOT volume and copy"
	log "the 'pico-8' folder from your Lexaloffle raspi zip onto it."
	say "PICO-8 nano 2W" "" "No pico-8 folder on the card." "" "Copy the pico-8 folder from" "Lexaloffle's Raspberry Pi zip" "onto the PICO8BOOT volume."
	sleep 10
	exit 1
fi

# pico8_dyn links against the system SDL2, which is the one we build with the
# KMSDRM backend. Prefer it. pico8 has its own SDL2 statically linked and is a
# usable fallback. pico8_64 is aarch64 and cannot run on this 32-bit userland.
BIN=""
for b in pico8_dyn pico8; do
	[ -x "${PICO_DIR}/${b}" ] || [ -f "${PICO_DIR}/${b}" ] || continue
	BIN="${PICO_DIR}/${b}"
	break
done

if [ -z "${BIN}" ]; then
	if [ -f "${PICO_DIR}/pico8_64" ]; then
		log "found only pico8_64, which is 64-bit. This image runs a 32-bit"
		log "userland -- you need pico8_dyn from the same zip."
		say "PICO-8 nano 2W" "" "Only pico8_64 found. This needs" "pico8_dyn from the same zip."
	else
		log "${PICO_DIR} contains no PICO-8 binary (looked for pico8_dyn, pico8)."
		say "PICO-8 nano 2W" "" "No pico8_dyn in the pico-8" "folder on the card."
	fi
	sleep 10
	exit 1
fi

mkdir -p "${PICO_HOME}"

# Launch mode from /boot/pico8.txt (same shape as wifi.txt). CR is stripped
# so a file saved on Windows works. Unknown or empty -> prompt, which is
# what this script did before the file existed.
MODE=prompt
if [ -f "${BOOT}/pico8.txt" ]; then
	m=$(sed -n 's/^[[:space:]]*mode=//p' "${BOOT}/pico8.txt" 2>/dev/null |
		head -1 | tr -d '\r' | sed 's/[[:space:]]*$//' | tr 'A-Z' 'a-z')
	[ -n "$m" ] && MODE=$m
fi

case "$MODE" in
	splore|prompt) ;;
	*)
		log "unknown mode='$MODE' in pico8.txt (want prompt or splore); using prompt"
		MODE=prompt
		;;
esac

# SDL2 has exactly two backends in this image: kmsdrm and dummy.
export SDL_VIDEODRIVER=kmsdrm
export HOME="${BOOT}"

set -- -home "${PICO_HOME}" -root_path "${PICO_HOME}/carts"
[ "$MODE" = splore ] && set -- "$@" -splore

# GPi Case (gpicase.txt adds a panel-dpi node).
#
# The LCD scans out 240x320 portrait. Our SDL2 patch turns the picture by
# the overlay's rotate= (a big-endian u32 in the device tree), so PICO-8
# sees 320x240. That is only 240 lines: PICO-8's default integer scaling
# gives 1x (128x128), so stretch to 240 instead.
#
# The speaker is the firmware PWM card; vc4 still registers an HDMI card,
# and SDL opens card 0 unless told.
if grep -qs panel-dpi /proc/device-tree/panel/compatible; then
	rot=$(od -An -tx1 /proc/device-tree/panel/rotation 2>/dev/null | tr -d ' \n')
	[ -n "$rot" ] && export SDL_KMSDRM_ROTATE=$((0x$rot))
	set -- "$@" -pixel_perfect 0
	export AUDIODEV=plughw:CARD=Headphones,DEV=0
fi

say "PICO-8 nano 2W" "" "Starting $(basename "${BIN}")..."
log "starting ${BIN} (mode=${MODE}) AUDIODEV=${AUDIODEV:-} SDL_KMSDRM_ROTATE=${SDL_KMSDRM_ROTATE:-} argv: $*"
dump_state

# Do not exec: when PICO-8 exits we still want dmesg on the card.
# Periodic sync so a hang/panic has a recent FAT flush. stderr is
# unbuffered so Mesa/SDL errors should land before a userspace abort.
(
	while true; do
		sync
		sleep 1
	done
) &
SYNCPID=$!

"${BIN}" "$@" >> "${LOGFILE}" 2>&1
rc=$?

kill "${SYNCPID}" 2>/dev/null
wait "${SYNCPID}" 2>/dev/null

log "PICO-8 exited rc=${rc}"
say "PICO-8 nano 2W" "" "PICO-8 stopped (code ${rc})." "Restarting..."
dump_state
sleep 2
exit "${rc}"
