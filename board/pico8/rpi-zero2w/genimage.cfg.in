# Three-partition layout (PRD 7):
#
#   p1  FAT32  /boot  read-only   firmware, kernel, dtb, config.txt, wifi.txt,
#                                 authorized_keys, carts/ drop-box
#   p2  ext4   /      read-only   base system and the PICO-8 binary
#   p3  ext4   /data  read-write  home, carts, saves, PICO-8 config
#
# The root is mounted read-only because the device has no shutdown button and
# users will pull the power. Only p3 is ever written at runtime, and it is
# resized to fill the card on first boot.
#
# The boot file list below is filled in by post-image.sh from whatever the
# firmware package actually installed, so it never has to be maintained by
# hand. Do not write the placeholder token anywhere else in this file --
# sed replaces every occurrence, including ones inside comments.

image boot.vfat {
	vfat {
		label = "PICO8BOOT"
		files = {
#BOOT_FILES#
		}
	}

	size = 48M
}

# Created empty and grown on first boot. Keep this small so the image stays
# quick to write; there is no point shipping empty blocks.
image data.ext4 {
	ext4 {
		label = "data"
		use-mke2fs = "true"
	}

	size = 128M
}

image sdcard.img {
	hdimage {
	}

	partition boot {
		partition-type = 0xC
		bootable = "true"
		image = "boot.vfat"
	}

	partition rootfs {
		partition-type = 0x83
		image = "rootfs.squashfs"
	}

	partition data {
		partition-type = 0x83
		image = "data.ext4"
	}
}
