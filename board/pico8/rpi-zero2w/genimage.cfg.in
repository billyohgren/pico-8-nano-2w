# Two-partition layout:
#
#   p1  FAT32  /boot  read-only   firmware, kernel, initramfs, dtb, config.txt,
#                                 wifi.txt, pico8.txt, authorized_keys, carts/
#   p2  ext4   /data  read-write  home, carts, saves, PICO-8 config
#
# The OS is the initramfs, unpacked into RAM. There is no root partition.
# Only p2 is ever written at runtime. It is resized to fill the card on
# first boot (not yet implemented).
#
# Boot is 192M because it has to hold gzip(rootfs) plus the user's pico-8
# folder. Empty FAT zeros zip off the image.
#
# The boot file list below is filled in by post-image.sh from whatever the
# firmware package actually installed, so it never has to be maintained by
# hand. Do not write the placeholder token anywhere else in this file --
# sed replaces every occurrence, including ones inside comments.

image boot.vfat {
	vfat {
		label = "PICO8BOOT"
		files = {
#BOOT_FILES#
		}
	}

	size = 192M
}

# Created empty and grown on first boot. Keep this small so the image stays
# quick to write; there is no point shipping empty blocks.
image data.ext4 {
	ext4 {
		label = "data"
		use-mke2fs = "true"
	}

	size = 128M
}

image sdcard.img {
	hdimage {
	}

	partition boot {
		partition-type = 0xC
		bootable = "true"
		image = "boot.vfat"
	}

	partition data {
		partition-type = 0x83
		image = "data.ext4"
	}
}
