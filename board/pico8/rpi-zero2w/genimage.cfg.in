# One FAT32 partition, PicoPi-style.
#
#   p1  FAT32  PICO8BOOT  /boot  read-write
#       firmware, kernel, initramfs, wifi.txt, pico8.txt, pico-8 binary,
#       carts, saves, ssh keys
#
# The OS is the initramfs (RAM). The card is only this volume. Format any
# size SD as FAT32 and copy the files from pico8-fat-files.zip onto it —
# that is how a 32 GB card stays 32 GB. sdcard.img exists for Raspberry
# Pi Imager; it is a 256 M card image, not a ceiling.
#
# PICO-8 writes saves here. FAT has no journal, so a power cut mid-save
# can scramble the volume (including firmware). That is the PicoPi
# tradeoff: most carts never save, and testers would rather copy files
# than reflash a two-partition image.
#
# The boot file list below is filled in by post-image.sh from whatever the
# firmware package actually installed. Do not write the placeholder token
# anywhere else in this file -- sed replaces every occurrence.

image boot.vfat {
	vfat {
		label = "PICO8BOOT"
		extraargs = "-F 32"
		files = {
#BOOT_FILES#
		}
	}

	size = 256M
}

image sdcard.img {
	hdimage {
	}

	partition boot {
		partition-type = 0xC
		bootable = "true"
		image = "boot.vfat"
	}
}
